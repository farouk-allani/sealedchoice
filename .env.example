# Copy to .env and fill in. .env is git-ignored. Farouk creates every account himself.
# Secrets live in the environment, never in the repository.

NETWORK=testnet
# RPC: verify the current public/free endpoint at T00 (docs.near.org RPC providers)
NEAR_RPC_URL=

# Contracts
CONTRACT_ID=tenders.sealedchoice.testnet
OUTLAYER_CONTRACT_ID=outlayer.testnet
TOKEN_ID=usdc.sealedchoice.testnet

# Accounts and keys (testnet). Private keys in near format: ed25519:...
DEPLOYER_ACCOUNT_ID=sealedchoice.testnet
DEPLOYER_PRIVATE_KEY=
BUYER_ACCOUNT_ID=buyer.sealedchoice.testnet
BUYER_PRIVATE_KEY=
REVIEWER_ACCOUNT_ID=reviewer.sealedchoice.testnet
REVIEWER_PRIVATE_KEY=
VENDOR_A_ACCOUNT_ID=vendor-a.sealedchoice.testnet
VENDOR_A_PRIVATE_KEY=
VENDOR_B_ACCOUNT_ID=vendor-b.sealedchoice.testnet
VENDOR_B_PRIVATE_KEY=
VENDOR_C_ACCOUNT_ID=vendor-c.sealedchoice.testnet
VENDOR_C_PRIVATE_KEY=
# account used by the attack demo to try things it must not be allowed to do
ATTACKER_ACCOUNT_ID=attacker.sealedchoice.testnet
ATTACKER_PRIVATE_KEY=

# OutLayer (values from the OutLayer dashboard, see G1)
OUTLAYER_SECRETS_PROFILE=
OUTLAYER_SECRETS_ACCOUNT_ID=
EVALUATOR_WASM_URL=
EVALUATOR_WASM_SHA256=

# NEAR AI Cloud: only for local spikes (G3). In production the key lives in OutLayer secrets.
NEARAI_API_KEY=

# Bundle store (apps/web API) - same token set as an OutLayer secret for the evaluator
BUNDLE_STORE_URL=
BUNDLE_STORE_TOKEN=
# storage backend token, depending on T06 choice (e.g. Vercel Blob)
BLOB_READ_WRITE_TOKEN=

# NEAR Intents 1Click (optional JWT; without it +0.25% fee)
ONECLICK_JWT=
